root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# The document shell ends in `</body></html>` with no newline, byte-for-byte.
[src/shell/index.html]
insert_final_newline = false

# Frozen provenance: never reformat.
[_init/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
